debian-php-backports: ported to PHP 5.4.45 (php5 5.4.45-0+deb7u30):
php_log_err() is the same in 5.4 (PG(modules_activated) and EG(active)
exist); the code change is unchanged.
---
 main/main.c | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/main/main.c b/main/main.c
index cbd1cad1..39214962 100644
--- a/main/main.c
+++ b/main/main.c
@@ -634,15 +634,7 @@ PHPAPI void php_log_err(char *log_message TSRMLS_DC)
 			char *error_time_str;
 
 			time(&error_time);
-#ifdef ZTS
-			if (!php_during_module_startup()) {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1 TSRMLS_CC);
-			} else {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 0 TSRMLS_CC);
-			}
-#else
-			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1 TSRMLS_CC);
-#endif
+			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, PG(modules_activated) && EG(active) TSRMLS_CC);
 			len = spprintf(&tmp, 0, "[%s] %s%s", error_time_str, log_message, PHP_EOL);
 #ifdef PHP_WIN32
 			php_flock(fd, 2);
