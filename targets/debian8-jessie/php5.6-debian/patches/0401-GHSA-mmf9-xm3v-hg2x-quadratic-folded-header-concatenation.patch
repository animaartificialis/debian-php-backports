From: debian-php-backports <anima.artificialis@gmail.com>
Date: Thu, 19 Nov 2026 18:00:00 +0000
Subject: GHSA-mmf9-xm3v-hg2x: stop quadratic folded HTTP response header
 concatenation

Fixes GHSA-mmf9-xm3v-hg2x
Fixes CVE-2026-127960

The HTTP stream wrapper joined every folded (continuation) response header
line to the header read so far by allocating a new buffer and copying the
whole header again. A malicious server could make PHP spend a lot of CPU
with a header split into many short lines.

This code came to php5 5.6.40+dfsg-0+deb8u23 with Freexian ELTS's backport
of the CVE-2025-1217 fix. Upstream fixed it in php-src commit
7b2a39410308db2c5db21cfe51920a54d2682324 (PHP 8.2.36) by collecting the
header in a smart_str. deb.sury.org php5.6 has no such patch, because its
5.6 does not have this folding code.

This is a 5.6 adaptation, not a cherry-pick: the 5.6 code keeps the header
in a char * with a length, and smart_str in 5.6 grows by a fixed 128 bytes,
so it would still copy often. Instead the buffer now has a tracked size
(last_header_line_size) and grows by doubling with erealloc(), and the
folded line is appended in place. The parsed header text is the same as
before.

The function also leaked the header line when it stored the header: the
stored value is a copy (ZVAL_STRINGL with duplicate = 1), but the line was
freed only when the header was not stored. It is now freed in both cases.
This leak was in ELTS's CVE-2025-1217 code already; with the doubling
buffer above the leaked block could be up to twice the header size.
---
 ext/standard/http_fopen_wrapper.c | 31 +++++++++++++++++++++----------
 1 file changed, 21 insertions(+), 10 deletions(-)

diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index 0359a24b..a5d6ef99 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -173,6 +173,7 @@ static zend_bool php_stream_http_response_header_trim(char *http_header_line,
 static char *php_stream_http_response_headers_parse(php_stream_wrapper *wrapper,
         php_stream *stream, php_stream_context *context, int options,
 		char **last_header_line, size_t *last_header_line_length,
+		size_t *last_header_line_size,
 		char *header_line, size_t *header_line_length, int response_code,
 		zval *response_header, php_stream_http_response_header_info *header_info)
 {
@@ -199,15 +200,21 @@ static char *php_stream_http_response_headers_parse(php_stream_wrapper *wrapper,
 			/* It has to have some characters because it would get returned after the call
 			 * php_stream_http_response_header_trim above. */
 			ZEND_ASSERT(http_folded_header_line_length > 0);
-			/* Concatenate last header line, space and current header line. */
+			/* Append space and current header line to the last header line. */
 			size_t len = *last_header_line_length + 1 + http_folded_header_line_length;
-			char *extended_header = emalloc(len + 1);
-			strncpy(extended_header, *last_header_line, *last_header_line_length);
-			extended_header[*last_header_line_length] = ' ';
-			strncpy(extended_header + *last_header_line_length + 1, http_folded_header_line, http_folded_header_line_length);
-			extended_header[len] = '\0';
-			efree(*last_header_line);
-			*last_header_line = extended_header;
+			if (len + 1 > *last_header_line_size) {
+				/* Grow the buffer geometrically, so that a header folded into many
+				 * lines is not copied again for every line. */
+				size_t size = *last_header_line_size * 2;
+				if (size < len + 1) {
+					size = len + 1;
+				}
+				*last_header_line = erealloc(*last_header_line, size);
+				*last_header_line_size = size;
+			}
+			(*last_header_line)[*last_header_line_length] = ' ';
+			memcpy(*last_header_line + *last_header_line_length + 1, http_folded_header_line, http_folded_header_line_length);
+			(*last_header_line)[len] = '\0';
 			*last_header_line_length = len;
 			/* Return new header line. */
 			return *last_header_line;
@@ -317,9 +324,9 @@ static char *php_stream_http_response_headers_parse(php_stream_wrapper *wrapper,
 		MAKE_STD_ZVAL(http_header);
 		ZVAL_STRINGL(http_header, *last_header_line, *last_header_line_length, 1);
 		zend_hash_next_index_insert(Z_ARRVAL_P(response_header), &http_header, sizeof(zval *), NULL);
-	} else {
-		efree(*last_header_line);
 	}
+	/* The stored header is a copy, so the line is freed in both cases. */
+	efree(*last_header_line);
 
 	return NULL;
 }
@@ -959,6 +966,7 @@ finish:
 
 	/* read past HTTP headers */
 	size_t last_header_line_len = 0;
+	size_t last_header_line_size = 0;
 	while (!body && !php_stream_eof(stream)) {
 		size_t http_header_line_length;
 
@@ -986,6 +994,7 @@ finish:
 				/* Parse last header line. */
 				last_header_line = php_stream_http_response_headers_parse(wrapper, stream,
 						context, options, &last_header_line, &last_header_line_len,
+						&last_header_line_size,
 						http_header_line, &http_header_line_length,
 						response_code, response_header, &header_info);
 				if (EXPECTED(last_header_line == NULL)) {
@@ -1020,6 +1029,7 @@ finish:
 			strncpy(last_header_line, http_header_line, http_header_line_length);
 			last_header_line[http_header_line_length] = '\0';
 			last_header_line_len = http_header_line_length;
+			last_header_line_size = http_header_line_length + 1;
 		} else {
 			break;
 		}
@@ -1029,6 +1039,7 @@ finish:
 	if (last_header_line != NULL) {
 		last_header_line = php_stream_http_response_headers_parse(wrapper, stream, context,
 				options, &last_header_line, &last_header_line_len,
+				&last_header_line_size,
 				NULL, NULL, response_code, response_header, &header_info);
 	}
 
