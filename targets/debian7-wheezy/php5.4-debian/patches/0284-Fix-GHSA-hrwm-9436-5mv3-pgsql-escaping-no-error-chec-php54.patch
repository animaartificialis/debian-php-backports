 ext/pgsql/pgsql.c                            | 105 ++++++++++++++++---
 ext/pgsql/tests/ghsa-hrwm-9436-5mv3.phpt     |  47 +++++++++
 4 files changed, 167 insertions(+), 17 deletions(-)

