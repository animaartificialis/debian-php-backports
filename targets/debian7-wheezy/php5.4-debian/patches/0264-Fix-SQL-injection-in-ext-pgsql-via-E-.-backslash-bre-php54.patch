 ext/pgsql/pgsql.c                        |  1 -
 ext/pgsql/tests/10pg_convert_9.phpt      |  4 +--
 ext/pgsql/tests/12pg_insert_9.phpt       |  2 +-
 ext/pgsql/tests/14pg_update_9.phpt       |  2 +-
 ext/pgsql/tests/GHSA-7qpv-r5mr-78m4.phpt | 41 ++++++++++++++++++++++++
 ext/pgsql/tests/bug64609.phpt            |  2 +-
 6 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/ext/pgsql/pgsql.c b/ext/pgsql/pgsql.c
index 584f881..d65f994 100644
--- a/ext/pgsql/pgsql.c
+++ b/ext/pgsql/pgsql.c
@@ -5370,7 +5370,6 @@ static int php_pgsql_add_quotes(zval *src, zend_bool should_free TSRMLS_DC)
 	assert(Z_TYPE_P(src) == IS_STRING);
 	assert(should_free == 1 || should_free == 0);
 
-	smart_str_appendc(&str, 'E');
 	smart_str_appendc(&str, '\'');
 	smart_str_appendl(&str, Z_STRVAL_P(src), Z_STRLEN_P(src));
 	smart_str_appendc(&str, '\'');
